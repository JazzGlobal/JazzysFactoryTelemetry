      "isDeleted": false,
      "boundElements": null,
      "updated": 1784412259183,
      "link": null,
      "locked": false,
      "text": "On failure, tag the payload with retry metadata (maximum retry configurable via\nserver.properties)\nThen enqueue the payload\n\nIf the payload reaches max number of retries, it isn't requeued, instead it is thrown away.",
      "fontSize": 123.99999999999999,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "On failure, tag the payload with retry metadata (maximum retry configurable via server.properties)\nThen enqueue the payload\n\nIf the payload reaches max number of retries, it isn't requeued, instead it is thrown away.",
      "autoResize": false,
      "lineHeight": 1.25
    },
