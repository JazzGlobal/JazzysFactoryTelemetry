    {
      "id": "vP14SkV5UOTPCemzIxjvM",
      "type": "text",
      "x": -7404.234126984138,
      "y": 714.8412698412758,
      "width": 6610.000000000004,
      "height": 600.0000000000001,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b53",
      "roundness": null,
      "seed": 2086180033,
      "version": 527,
      "versionNonce": 322735681,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784309507065,
      "link": null,
      "locked": false,
      "text": "The Telemetry Node does nothing by itself. If it has no machines to poll, it does not send Machine Snapshots\n\nNOTE: Should it send data about itself? If there is a concept of Telemetry Node states, does the API need\nto know about those states?",
      "fontSize": 120.00000000000003,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Telemetry Node does nothing by itself. If it has no machines to poll, it does not send Machine Snapshots\n\nNOTE: Should it send data about itself? If there is a concept of Telemetry Node states, does the API need to know about those states?",
      "autoResize": false,
      "lineHeight": 1.25
    },
