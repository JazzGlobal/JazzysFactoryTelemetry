    {
      "id": "IuUHIWc1CR8fCMFf7iGoi",
      "type": "text",
      "x": -1488.6309523809605,
      "y": -1072.9999999999973,
      "width": 1353.04345703125,
      "height": 244.99999999999986,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3p",
      "roundness": null,
      "seed": 641833687,
      "version": 1357,
      "versionNonce": 381424232,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784234907823,
      "link": null,
      "locked": false,
      "text": "On a configured interval, the server will pop snapshots off the queue and send them to the API.\nThe number of snapshots to be sent in a single bundle is configurable, as is the maximum number\nof items the queue can contain at any given time. If the queue is filled to the maximum, the server\nwill attempt a send.\n\nThis level of configurability will give additional knobs for server admins to use during\nperformance tuning.",
      "fontSize": 27.999999999999982,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "On a configured interval, the server will pop snapshots off the queue and send them to the API.\nThe number of snapshots to be sent in a single bundle is configurable, as is the maximum number\nof items the queue can contain at any given time. If the queue is filled to the maximum, the server\nwill attempt a send.\n\nThis level of configurability will give additional knobs for server admins to use during\nperformance tuning.",
      "autoResize": true,
      "lineHeight": 1.25
    },
