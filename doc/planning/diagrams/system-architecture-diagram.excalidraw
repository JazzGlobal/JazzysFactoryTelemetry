      "link": null,
      "locked": false,
      "text": "The Snapshot Sender is responsible for popping snapshots off the Outbound Snapshot queue\nand sending them to the API.\n\nThe Snapshot Sender will handle failure retries and HTTP errors.",
      "fontSize": 27.999999999999996,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Snapshot Sender is responsible for popping snapshots off the Outbound Snapshot queue\nand sending them to the API.\n\nThe Snapshot Sender will handle failure retries and HTTP errors.",
      "autoResize": true,
      "lineHeight": 1.25
